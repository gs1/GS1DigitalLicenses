/* Key Credential → Data Credential: child credentialSubject.id must exactly match parent's gs1DigitalLink */
(
  $escaped := $replace(credentialSubject.gs1DigitalLink, ".", "\\.");
  {
    "properties": {
      "credentialSubject": {
        "properties": {
          "id": {
            "type": "string",
            "pattern": "^" & $escaped & "$"
          }
        }
      }
    }
  }
)
