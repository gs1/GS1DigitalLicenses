  "validFrom": "2024-01-25T12:30:00.000Z",
  "credentialStatus": {
    "id": "https://gs1.github.io/GS1DigitalLicenses/status/gcp-mo#0",
    "type": "BitstringStatusListEntry",
    "statusPurpose": "revocation",
    "statusListIndex": "0",
    "statusListCredential": "https://gs1.github.io/GS1DigitalLicenses/status/gcp-mo"
  },
