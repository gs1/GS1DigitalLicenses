        "digestMultibase": "uEiDyW_dw6Fqe5pcj2btbColz_TyMTNTHp31KvW8bmuTt-w"
      }
    }
  ],
  "credentialSubject": {
    "id": "did:web:gs1.github.io:GS1DigitalLicenses:dids:fake_mo_did",
    "type": "RecognizedEntity",
    "organization": {
      "gs1:partyGLN": "0614141000005",
      "gs1:organizationName": "GS1 Utopia"
    },
    "licenseValue": "081015956",
    "alternativeLicenseValue": "81015956",
    "recognizedTo": [
      {
        "type": "RecognizedAction",
        "name": "GS1 Key Credentials",
        "action": "issue",
        "recognizedBy": "did:web:gs1.github.io:GS1DigitalLicenses:dids:fake_mo_did",
        "outputValidation": [
          {
            "type": "JsonSchema",
            "id": "https://gs1.github.io/GS1DigitalLicenses/schemas/recognized-entities-field/base/gs1-key-credential.json",
            "name": "GS1 Key Credential"
          },
          {
            "type": "FieldMatch",
            "sourceField": "credentialSubject.licenseValue",
            "outputField": {
              "path": "credentialSubject.gs1DigitalLink",
              "pattern": "^https://id\\.gs1\\.org/(01|8006|8013|8010|414|417|8017|8018|255|00|253|401|402|8003|8004)/0*{sourceValue}\\d+"
            }
          }
        ]
      },
      {
        "type": "RecognizedAction",
        "name": "GS1 ID Key Licenses",
        "action": "issue",
        "recognizedBy": "did:web:gs1.github.io:GS1DigitalLicenses:dids:fake_mo_did",
        "outputValidation": [
          {
            "type": "JsonSchema",
            "id": "https://gs1.github.io/GS1DigitalLicenses/schemas/recognized-entities-field/base/gs1-identification-key-license-credential.json",
            "name": "GS1 Identification Key License Credential"
          },
          {
            "type": "FieldMatch",
            "sourceField": "credentialSubject.licenseValue",
            "outputField": {
              "path": "credentialSubject.licenseValue",
              "pattern": "^0*{sourceValue}\\d+$"
            }
          }
        ]
      }
