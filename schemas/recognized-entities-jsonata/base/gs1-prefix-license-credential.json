{
  "$id": "gs1-prefix-license-credential",
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "title": "GS1PrefixLicenseCredential",
  "description": "A GS1 Prefix License issued by GS1 Global Office to a Member Organization. Root-of-trust credential — does not require recognizedIn.",
  "type": "object",
  "allOf": [
    {
      "$ref": "gs1-license-credential.json"
    }
  ],
  "$defs": {
    "PrefixLicenseSubject": {
      "title": "GS1 Prefix License Subject",
      "allOf": [
        { "$ref": "gs1-license-credential.json#/$defs/LicenseSubjectBase" }
      ],
      "type": "object",
      "properties": {
        "licenseValue": {
          "title": "GS1 Prefix License Value",
          "type": "string",
          "pattern": "^\\d{2,7}$"
        }
      },
      "properties": {
        "recognizedTo": {
          "properties": {
            "outputValidation": {
              "contains": {
                "properties": {
                  "type": { "const": "Jsonata" },
                  "generator": { "const": "https://gs1.github.io/GS1DigitalLicenses/jsonata/recognized-entities-jsonata/prefix-to-gcp.jsonata" },
                  "digestMultibase": { "const": "uEiCOWSw6jUU8bhn4OeLew0_bWhzN7GWGloWFvRw-wNS2Yw" }
                },
                "required": ["type", "generator", "digestMultibase"]
              }
            }
          }
        }
      },
      "required": ["id", "type", "organization", "licenseValue", "recognizedTo"]
    }
  },
  "properties": {
    "type": {
      "type": "array",
      "contains": { "const": "GS1PrefixLicenseCredential" }
    },
    "credentialSubject": {
      "oneOf": [
        { "$ref": "#/$defs/PrefixLicenseSubject" },
        { "type": "array", "items": { "$ref": "#/$defs/PrefixLicenseSubject" }, "minItems": 1 }
      ]
    }
  }
}
