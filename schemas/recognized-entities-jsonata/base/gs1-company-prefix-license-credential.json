{
  "$id": "gs1-company-prefix-license-credential",
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "title": "GS1CompanyPrefixLicenseCredential",
  "description": "A GS1 Company Prefix License issued by a Member Organization to a Member Company. Issuer must be recognized in a GS1 Prefix License credential.",
  "type": "object",
  "allOf": [
    {
      "$ref": "gs1-license-credential.json"
    }
  ],
  "$defs": {
    "GCPToKeyCredentialGenerator": {
      "description": "For GCP→key credential delegation: generator produces a schema constraining gs1DigitalLink to contain the GCP.",
      "properties": {
        "type": { "const": "Jsonata" },
        "generator": { "const": "https://gs1.github.io/GS1DigitalLicenses/jsonata/recognized-entities-jsonata/gcp-to-key.jsonata" },
        "digestMultibase": { "const": "uEiCa-PRd8Mo9jexd7fTMBj6ZJg284_osh0xSA7r6zJEyGA" }
      },
      "required": ["type", "generator", "digestMultibase"]
    },
    "GCPToIdKeyLicenseGenerator": {
      "description": "For GCP→ID key license delegation: generator produces a schema constraining licenseValue to extend the GCP.",
      "properties": {
        "type": { "const": "Jsonata" },
        "generator": { "const": "https://gs1.github.io/GS1DigitalLicenses/jsonata/recognized-entities-jsonata/gcp-to-idkey.jsonata" },
        "digestMultibase": { "const": "uEiBMDMtlpnJDyIERJg9E4vQX-IPx2Og_Tta6kWXvvNh0qA" }
      },
      "required": ["type", "generator", "digestMultibase"]
    },
    "CompanyPrefixLicenseSubject": {
      "title": "GS1 Company Prefix License Subject",
      "allOf": [
        { "$ref": "gs1-license-credential.json#/$defs/LicenseSubjectBase" }
      ],
      "type": "object",
      "properties": {
        "licenseValue": {
          "title": "GS1 Company Prefix License Value",
          "type": "string",
          "pattern": "^\\d{4,12}$"
        }
      },
      "properties": {
        "recognizedTo": {
          "oneOf": [
            {
              "type": "object",
              "properties": {
                "outputValidation": {
                  "contains": {
                    "oneOf": [
                      { "$ref": "#/$defs/GCPToKeyCredentialGenerator" },
                      { "$ref": "#/$defs/GCPToIdKeyLicenseGenerator" }
                    ]
                  }
                }
              }
            },
            {
              "type": "array",
              "items": {
                "properties": {
                  "outputValidation": {
                    "contains": {
                      "oneOf": [
                        { "$ref": "#/$defs/GCPToKeyCredentialGenerator" },
                        { "$ref": "#/$defs/GCPToIdKeyLicenseGenerator" }
                      ]
                    }
                  }
                }
              }
            }
          ]
        }
      },
      "required": ["id", "type", "organization", "licenseValue"]
    }
  },
  "properties": {
    "type": {
      "type": "array",
      "contains": { "const": "GS1CompanyPrefixLicenseCredential" }
    },
    "issuer": {
      "type": "object",
      "properties": {
        "id": {
          "$ref": "recognized-entity-credential.json#/$defs/DID"
        },
        "recognizedIn": {
          "allOf": [
            { "$ref": "recognized-entity-credential.json#/$defs/RecognizedIn" },
            {
              "properties": {
                "type": {
                  "type": "array",
                  "allOf": [
                    { "contains": { "const": "RecognizedEntityCredential" } },
                    { "contains": { "const": "GS1PrefixLicenseCredential" } }
                  ]
                }
              }
            }
          ]
        }
      },
      "required": ["id", "recognizedIn"]
    },
    "credentialSubject": {
      "oneOf": [
        { "$ref": "#/$defs/CompanyPrefixLicenseSubject" },
        { "type": "array", "items": { "$ref": "#/$defs/CompanyPrefixLicenseSubject" }, "minItems": 1 }
      ]
    }
  }
}
