{
  "$id": "gs1-company-prefix-license-credential",
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "title": "GS1CompanyPrefixLicenseCredential",
  "description": "A GS1 Company Prefix License issued by a Member Organization to a Member Company. Issuer must be recognized in a GS1 Prefix License credential.",
  "type": "object",
  "allOf": [
    {
      "$ref": "gs1-license-credential.json"
    }
  ],
  "$defs": {
    "GCPToKeyCredentialFieldMatch": {
      "description": "For GCP→key credential delegation: the child's gs1DigitalLink must contain the GCP's licenseValue under a GS1 AI.",
      "properties": {
        "type": { "const": "FieldMatch" },
        "sourceField": { "const": "credentialSubject.licenseValue" },
        "outputField": {
          "properties": {
            "path": { "const": "credentialSubject.gs1DigitalLink" }
          },
          "required": ["path", "pattern"]
        }
      },
      "required": ["type", "sourceField", "outputField"]
    },
    "GCPToIdKeyLicenseFieldMatch": {
      "description": "For GCP→ID key license delegation: the child's licenseValue must extend the GCP's licenseValue.",
      "properties": {
        "type": { "const": "FieldMatch" },
        "sourceField": { "const": "credentialSubject.licenseValue" },
        "outputField": {
          "properties": {
            "path": { "const": "credentialSubject.licenseValue" }
          },
          "required": ["path", "pattern"]
        }
      },
      "required": ["type", "sourceField", "outputField"]
    },
    "CompanyPrefixLicenseSubject": {
      "title": "GS1 Company Prefix License Subject",
      "allOf": [
        { "$ref": "gs1-license-credential.json#/$defs/LicenseSubjectBase" }
      ],
      "type": "object",
      "properties": {
        "licenseValue": {
          "title": "GS1 Company Prefix License Value",
          "type": "string",
          "pattern": "^\\d{4,12}$"
        }
      },
      "properties": {
        "recognizedTo": {
          "oneOf": [
            {
              "type": "object",
              "properties": {
                "outputValidation": {
                  "contains": {
                    "oneOf": [
                      { "$ref": "#/$defs/GCPToKeyCredentialFieldMatch" },
                      { "$ref": "#/$defs/GCPToIdKeyLicenseFieldMatch" }
                    ]
                  }
                }
              }
            },
            {
              "type": "array",
              "items": {
                "properties": {
                  "outputValidation": {
                    "contains": {
                      "oneOf": [
                        { "$ref": "#/$defs/GCPToKeyCredentialFieldMatch" },
                        { "$ref": "#/$defs/GCPToIdKeyLicenseFieldMatch" }
                      ]
                    }
                  }
                }
              }
            }
          ]
        }
      },
      "required": ["id", "type", "organization", "licenseValue"]
    }
  },
  "properties": {
    "type": {
      "type": "array",
      "contains": { "const": "GS1CompanyPrefixLicenseCredential" }
    },
    "issuer": {
      "type": "object",
      "properties": {
        "id": {
          "$ref": "recognized-entity-credential.json#/$defs/DID"
        },
        "recognizedIn": {
          "allOf": [
            { "$ref": "recognized-entity-credential.json#/$defs/RecognizedIn" },
            {
              "properties": {
                "type": {
                  "type": "array",
                  "allOf": [
                    { "contains": { "const": "RecognizedEntityCredential" } },
                    { "contains": { "const": "GS1PrefixLicenseCredential" } }
                  ]
                }
              }
            }
          ]
        }
      },
      "required": ["id", "recognizedIn"]
    },
    "credentialSubject": {
      "oneOf": [
        { "$ref": "#/$defs/CompanyPrefixLicenseSubject" },
        { "type": "array", "items": { "$ref": "#/$defs/CompanyPrefixLicenseSubject" }, "minItems": 1 }
      ]
    }
  }
}
