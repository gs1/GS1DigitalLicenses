{
  "$id": "gs1-key-credential",
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "title": "GS1KeyCredential",
  "description": "A GS1 Key Credential asserting a relationship between a DID and a GS1 ID Key. When recognizedTo is present, it delegates authority to issue data credentials about that key.",
  "type": "object",
  "allOf": [
    {
      "$ref": "https://www.w3.org/2022/credentials/v2/verifiable-credential-schema.json"
    }
  ],
  "$defs": {
    "KeyToKeyDelegationFieldMatch": {
      "description": "For key→key delegation: child's gs1DigitalLink must start with parent's (left-match, allows path narrowing for batch/lot etc.).",
      "properties": {
        "type": { "const": "FieldMatch" },
        "sourceField": { "const": "credentialSubject.gs1DigitalLink" },
        "outputField": {
          "properties": {
            "path": { "const": "credentialSubject.gs1DigitalLink" },
            "pattern": { "const": "^{sourceValue}" }
          },
          "required": ["path", "pattern"]
        }
      },
      "required": ["type", "sourceField", "outputField"]
    },
    "KeyToDataDelegationFieldMatch": {
      "description": "For key→data delegation: data credential's credentialSubject.id must exactly match the key credential's gs1DigitalLink.",
      "properties": {
        "type": { "const": "FieldMatch" },
        "sourceField": { "const": "credentialSubject.gs1DigitalLink" },
        "outputField": {
          "properties": {
            "path": { "const": "credentialSubject.id" },
            "pattern": { "const": "^{sourceValue}$" }
          },
          "required": ["path", "pattern"]
        }
      },
      "required": ["type", "sourceField", "outputField"]
    },
    "GS1KeyCredentialSubject": {
      "title": "GS1 Key Credential Subject",
      "type": "object",
      "properties": {
        "id": {
          "$ref": "recognized-entity-credential.json#/$defs/DID"
        },
        "type": {
          "oneOf": [
            { "const": "RecognizedEntity" },
            { "type": "array", "contains": { "const": "RecognizedEntity" } }
          ]
        },
        "name": {
          "type": "string"
        },
        "gs1DigitalLink": {
          "$ref": "gs1-common.json#/$defs/GS1DigitalLink"
        },
        "recognizedTo": {
          "allOf": [
            { "$ref": "recognized-entity-credential.json#/$defs/RecognizedActionOneOrMany" },
            {
              "oneOf": [
                {
                  "type": "object",
                  "properties": {
                    "outputValidation": {
                      "contains": {
                        "oneOf": [
                          { "$ref": "#/$defs/KeyToKeyDelegationFieldMatch" },
                          { "$ref": "#/$defs/KeyToDataDelegationFieldMatch" }
                        ]
                      }
                    }
                  }
                },
                {
                  "type": "array",
                  "contains": {
                    "properties": {
                      "outputValidation": {
                        "contains": {
                          "oneOf": [
                            { "$ref": "#/$defs/KeyToKeyDelegationFieldMatch" },
                            { "$ref": "#/$defs/KeyToDataDelegationFieldMatch" }
                          ]
                        }
                      }
                    }
                  }
                }
              ]
            }
          ]
        }
      },
      "required": ["id", "type", "gs1DigitalLink"]
    }
  },
  "properties": {
    "@context": {
      "$ref": "recognized-entity-credential.json#/$defs/ContextArray",
      "allOf": [
        { "contains": { "const": "https://www.w3.org/ns/credentials/v2" } },
        { "contains": { "const": "https://www.w3.org/ns/credentials/recognized-entities/v1" } },
        { "contains": { "const": "https://ref.gs1.org/gs1/vc/declaration-context" } }
      ]
    },
    "type": {
      "type": "array",
      "allOf": [
        { "contains": { "const": "GS1KeyCredential" } },
        { "contains": { "const": "RecognizedEntityCredential" } }
      ]
    },
    "issuer": {
      "$ref": "recognized-entity-credential.json#/$defs/RecognizedIssuer",
      "type": "object",
      "properties": {
        "id": {
          "$ref": "recognized-entity-credential.json#/$defs/DID"
        },
        "recognizedIn": {
          "allOf": [
            { "$ref": "recognized-entity-credential.json#/$defs/RecognizedIn" },
            {
              "properties": {
                "type": {
                  "type": "array",
                  "allOf": [
                    { "contains": { "const": "RecognizedEntityCredential" } },
                    {
                      "oneOf": [
                        { "contains": { "const": "GS1CompanyPrefixLicenseCredential" } },
                        { "contains": { "const": "GS1IdentificationKeyLicenseCredential" } },
                        { "contains": { "const": "GS1KeyCredential" } }
                      ]
                    }
                  ]
                }
              }
            }
          ]
        }
      },
      "required": ["id", "recognizedIn"]
    },
    "credentialSubject": {
      "oneOf": [
        { "$ref": "#/$defs/GS1KeyCredentialSubject" },
        { "type": "array", "items": { "$ref": "#/$defs/GS1KeyCredentialSubject" }, "minItems": 1 }
      ]
    }
  },
  "required": ["@context", "type", "issuer", "credentialSubject"]
}
