{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "title": "Shipment Data Credential Schema",
  "allOf": [
    {
      "$ref": "gs1-data-credential.json"
    }
  ],
  "properties": {
    "credentialSubject": {
      "type": "object",
      "properties": {
        "shipment": {
          "type": "object",
          "properties": {
            "gs1:shipDate": {
              "type": "string",
              "format": "date"
            },
            "gs1:shipmentWeight": {
              "$ref": "#/$defs/QuantitativeValue"
            }
          },
          "additionalProperties": false
        }
      }
    }
  },
  "$defs": {
    "QuantitativeValue": {
      "type": "object",
      "properties": {
        "gs1:value": {
          "type": "string"
        },
        "gs1:unitCode": {
          "type": "string"
        }
      },
      "required": [
        "gs1:value",
        "gs1:unitCode"
      ]
    }
  }
}
