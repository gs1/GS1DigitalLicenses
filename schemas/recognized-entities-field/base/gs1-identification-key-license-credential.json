{
  "$id": "gs1-identification-key-license-credential",
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "title": "GS1IdentificationKeyLicenseCredential",
  "description": "A GS1 Identification Key License issued by a Member Organization to a Member Company for a single GS1 ID Key.",
  "type": "object",
  "allOf": [
    {
      "$ref": "gs1-license-credential.json"
    }
  ],
  "$defs": {
    "GTINFieldMatch": {
      "description": "For GTIN ID key license→key credential delegation: the child's gs1DigitalLink must use AI 01.",
      "properties": {
        "type": { "const": "FieldMatch" },
        "sourceField": { "const": "credentialSubject.licenseValue" },
        "outputField": {
          "properties": {
            "path": { "const": "credentialSubject.gs1DigitalLink" },
            "pattern": { "const": "^https://id\\.gs1\\.org/01/{sourceValue}" }
          },
          "required": ["path", "pattern"]
        }
      },
      "required": ["type", "sourceField", "outputField"]
    },
    "GLNFieldMatch": {
      "description": "For GLN ID key license→key credential delegation: the child's gs1DigitalLink must use AI 417.",
      "properties": {
        "type": { "const": "FieldMatch" },
        "sourceField": { "const": "credentialSubject.licenseValue" },
        "outputField": {
          "properties": {
            "path": { "const": "credentialSubject.gs1DigitalLink" },
            "pattern": { "const": "^https://id\\.gs1\\.org/417/{sourceValue}" }
          },
          "required": ["path", "pattern"]
        }
      },
      "required": ["type", "sourceField", "outputField"]
    },
    "RecognizedToWithFieldMatch": {
      "oneOf": [
        {
          "type": "object",
          "properties": {
            "outputValidation": { "type": "array" }
          }
        },
        {
          "type": "array",
          "items": {
            "properties": {
              "outputValidation": { "type": "array" }
            }
          }
        }
      ]
    },
    "IdentificationKeyLicenseSubject": {
      "title": "GS1 Identification Key License Subject",
      "allOf": [
        { "$ref": "gs1-license-credential.json#/$defs/LicenseSubjectBase" },
        {
          "if": {
            "properties": { "identificationKeyType": { "const": "GTIN" } },
            "required": ["identificationKeyType"]
          },
          "then": {
            "properties": {
              "recognizedTo": {
                "oneOf": [
                  {
                    "type": "object",
                    "properties": {
                      "outputValidation": {
                        "contains": { "$ref": "#/$defs/GTINFieldMatch" }
                      }
                    }
                  },
                  {
                    "type": "array",
                    "items": {
                      "properties": {
                        "outputValidation": {
                          "contains": { "$ref": "#/$defs/GTINFieldMatch" }
                        }
                      }
                    }
                  }
                ]
              }
            }
          }
        },
        {
          "if": {
            "properties": { "identificationKeyType": { "const": "GLN" } },
            "required": ["identificationKeyType"]
          },
          "then": {
            "properties": {
              "recognizedTo": {
                "oneOf": [
                  {
                    "type": "object",
                    "properties": {
                      "outputValidation": {
                        "contains": { "$ref": "#/$defs/GLNFieldMatch" }
                      }
                    }
                  },
                  {
                    "type": "array",
                    "items": {
                      "properties": {
                        "outputValidation": {
                          "contains": { "$ref": "#/$defs/GLNFieldMatch" }
                        }
                      }
                    }
                  }
                ]
              }
            }
          }
        }
      ],
      "type": "object",
      "properties": {
        "licenseValue": {
          "$ref": "gs1-common.json#/$defs/GS1IdentificationKey"
        }
      },
      "required": ["id", "type", "organization", "licenseValue", "identificationKeyType"]
    }
  },
  "properties": {
    "type": {
      "type": "array",
      "contains": { "const": "GS1IdentificationKeyLicenseCredential" }
    },
    "issuer": {
      "type": "object",
      "properties": {
        "id": {
          "$ref": "recognized-entity-credential.json#/$defs/DID"
        },
        "recognizedIn": {
          "allOf": [
            { "$ref": "recognized-entity-credential.json#/$defs/RecognizedIn" },
            {
              "properties": {
                "type": {
                  "type": "array",
                  "allOf": [
                    { "contains": { "const": "RecognizedEntityCredential" } },
                    {
                      "oneOf": [
                        { "contains": { "const": "GS1PrefixLicenseCredential" } },
                        { "contains": { "const": "GS18PrefixLicenseCredential" } },
                        { "contains": { "const": "GS1CompanyPrefixLicenseCredential" } }
                      ]
                    }
                  ]
                }
              }
            }
          ]
        }
      },
      "required": ["id", "recognizedIn"]
    },
    "credentialSubject": {
      "oneOf": [
        { "$ref": "#/$defs/IdentificationKeyLicenseSubject" },
        { "type": "array", "items": { "$ref": "#/$defs/IdentificationKeyLicenseSubject" }, "minItems": 1 }
      ]
    }
  }
}
