{
  "$id": "gs1-8prefix-license-credential",
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "title": "GS18PrefixLicenseCredential",
  "description": "A GS1-8 Prefix License issued by GS1 Global Office to a Member Organization for GTIN-8 issuance. Root-of-trust credential — does not require recognizedIn.",
  "type": "object",
  "allOf": [
    {
      "$ref": "gs1-license-credential.json"
    }
  ],
  "$defs": {
    "Prefix8LicenseSubject": {
      "title": "GS1-8 Prefix License Subject",
      "allOf": [
        { "$ref": "gs1-license-credential.json#/$defs/LicenseSubjectBase" }
      ],
      "type": "object",
      "properties": {
        "licenseValue": {
          "title": "GS1-8 Prefix License Value",
          "type": "string",
          "pattern": "^\\d{2,3}$"
        }
      },
      "properties": {
        "recognizedTo": {
          "properties": {
            "outputValidation": {
              "contains": {
                "properties": {
                  "type": { "const": "FieldMatch" },
                  "sourceField": { "const": "credentialSubject.licenseValue" },
                  "outputField": {
                    "properties": {
                      "path": { "const": "credentialSubject.licenseValue" },
                      "pattern": { "const": "^0+{sourceValue}\\d+$" }
                    },
                    "required": ["path", "pattern"]
                  }
                },
                "required": ["type", "sourceField", "outputField"]
              }
            }
          }
        }
      },
      "required": ["id", "type", "organization", "licenseValue", "recognizedTo"]
    }
  },
  "properties": {
    "type": {
      "type": "array",
      "contains": { "const": "GS18PrefixLicenseCredential" }
    },
    "credentialSubject": {
      "oneOf": [
        { "$ref": "#/$defs/Prefix8LicenseSubject" },
        { "type": "array", "items": { "$ref": "#/$defs/Prefix8LicenseSubject" }, "minItems": 1 }
      ]
    }
  }
}
