{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "title": "GS1 Recognized Entity Credential Schema",
  "type": "object",
  "required": ["@context", "type", "credentialSubject"],
  "properties": {
    "@context": {
      "type": "array",
      "items": {
        "type": "string"
      },
      "contains": {
        "const": "https://www.w3.org/ns/credentials/v2"
      },
      "allOf": [
        {
          "contains": {
            "const": "https://ref.gs1.org/gs1/vc/licence-context"
          }
        }
      ]
    },
    "type": {
      "type": "array",
      "items": {
        "type": "string"
      },
      "contains": {
        "const": "VerifiableCredential"
      },
      "allOf": [
        {
          "contains": {
            "const": "RecognizedEntityCredential"
          }
        }
      ]
    },
    "credentialSubject": {
      "type": "array",
      "items": {
        "type": "object",
        "required": ["licenceValue"],
        "properties": {
          "licenceValue": {
            "type": "string",
            "pattern": "^08[0-9]*$"
          }
        }
      }
    }
  }
}
