{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "title": "GCP 081015956 ID Key License Output Validation",
  "allOf": [
    {
      "$ref": "../base/gs1-identification-key-license-credential.json"
    }
  ],
  "properties": {
    "credentialSubject": {
      "type": "object",
      "properties": {
        "licenseValue": {
          "pattern": "^0081015956[0-9]*$"
        }
      }
    }
  }
}
