{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "title": "GCP 081015955 Key Authorization Output Validation Schema",
  "description": "Validates that Key Authorization Credentials issued under GCP 081015955 authorize keys matching the expected GS1 Digital Link pattern.",
  "allOf": [
    {
      "$ref": "../base/gs1-key-authorization-credential.json"
    }
  ],
  "properties": {
    "credentialSubject": {
      "oneOf": [
        { "$ref": "#/$defs/GCP081015955KeyAuthSubject" },
        {
          "type": "array",
          "items": { "$ref": "#/$defs/GCP081015955KeyAuthSubject" }
        }
      ]
    }
  },
  "$defs": {
    "GCP081015955KeyAuthSubject": {
      "type": "object",
      "properties": {
        "gs1DigitalLink": {
          "type": "string",
          "pattern": "01\\/00810159550[0-9]*"
        }
      },
      "required": ["gs1DigitalLink"]
    }
  }
}
