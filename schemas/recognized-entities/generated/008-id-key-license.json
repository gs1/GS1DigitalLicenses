{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "title": "GS1 Prefix 08 ID Key License Output Validation",
  "allOf": [
    {
      "$ref": "../base/gs1-identification-key-license-credential.json"
    }
  ],
  "properties": {
    "credentialSubject": {
      "contains": {
        "properties": {
          "licenseValue": {
            "pattern": "^008[0-9]*$"
          }
        }
      }
    }
  }
}
