{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "title": "GS1 Prefix 08 ID Key License Output Validation Schema",
  "description": "Validates that GS1 Identification Key License Credentials issued under GS1 Prefix 08 have a licenseValue starting with 008.",
  "allOf": [
    {
      "$ref": "../base/gs1-identification-key-license-credential.json"
    }
  ],
  "properties": {
    "credentialSubject": {
      "oneOf": [
        { "$ref": "#/$defs/Prefix08IdKeySubject" },
        {
          "type": "array",
          "items": { "$ref": "#/$defs/Prefix08IdKeySubject" }
        }
      ]
    }
  },
  "$defs": {
    "Prefix08IdKeySubject": {
      "type": "object",
      "properties": {
        "licenseValue": {
          "type": "string",
          "pattern": "^008[0-9]*$"
        }
      },
      "required": ["licenseValue", "identificationKeyType"]
    }
  }
}
