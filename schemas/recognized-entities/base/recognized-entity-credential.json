{
  "$id": "recognized-entity-credential",
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "title": "RecognizedEntityCredential",
  "description": "A Verifiable Credential that recognizes one or more entities and describes actions they are recognized to perform. Based on W3C Recognized Entities v1.0.",
  "type": "object",
  "allOf": [
    {
      "$ref": "https://www.w3.org/2022/credentials/v2/verifiable-credential-schema.json"
    }
  ],
  "$defs": {
    "DID": {
      "title": "Decentralized Identifier (DID)",
      "type": "string",
      "format": "uri",
      "pattern": "^did:[a-z0-9]+:(?:[A-Za-z0-9._-]|%[0-9A-Fa-f]{2})+(?::(?:[A-Za-z0-9._-]|%[0-9A-Fa-f]{2})+)*$"
    },
    "ContextArray": {
      "title": "JSON-LD Context Array",
      "type": "array",
      "items": {
        "oneOf": [
          { "type": "string", "format": "uri" },
          { "type": "object" }
        ]
      }
    },
    "GeneralProperties": {
      "type": "object",
      "properties": {
        "id": {
          "type": "string",
          "format": "uri"
        },
        "type": {
          "oneOf": [
            { "type": "string" },
            {
              "type": "array",
              "items": { "type": "string" },
              "minItems": 1
            }
          ]
        },
        "name": {
          "type": "string"
        },
        "legalName": {
          "type": "string"
        },
        "image": {
          "type": "string",
          "format": "uri"
        },
        "url": {
          "type": "string",
          "format": "uri"
        },
        "sameAs": {
          "oneOf": [
            { "type": "string", "format": "uri" },
            {
              "type": "array",
              "items": { "type": "string", "format": "uri" }
            }
          ]
        },
        "description": {
          "type": "string"
        },
        "digestMultibase": {
          "type": "string"
        }
      }
    },
    "RecognizedIn": {
      "type": "object",
      "description": "A reference to a document or credential that recognizes this entity.",
      "properties": {
        "id": {
          "type": "string",
          "format": "uri"
        },
        "type": {
          "oneOf": [
            { "type": "string" },
            {
              "type": "array",
              "items": { "type": "string" },
              "minItems": 1
            }
          ]
        },
        "name": {
          "type": "string"
        }
      },
      "required": ["id", "type"]
    },
    "OutputValidation": {
      "type": "object",
      "description": "A data schema that verifiers use to determine whether output conforms to expected format.",
      "properties": {
        "id": {
          "type": "string",
          "format": "uri"
        },
        "type": {
          "type": "string"
        },
        "name": {
          "type": "string"
        },
        "digestMultibase": {
          "type": "string"
        }
      },
      "required": ["id", "type"]
    },
    "RecognizedAction": {
      "type": "object",
      "description": "Describes an action that a recognized entity is authorized to perform.",
      "properties": {
        "type": {
          "type": "string",
          "const": "RecognizedAction"
        },
        "action": {
          "type": "string"
        },
        "recognizedBy": {
          "oneOf": [
            { "type": "string", "format": "uri" },
            {
              "allOf": [
                { "$ref": "#/$defs/GeneralProperties" },
                {
                  "type": "object",
                  "required": ["id"]
                }
              ]
            }
          ]
        },
        "outputValidation": {
          "oneOf": [
            { "$ref": "#/$defs/OutputValidation" },
            {
              "type": "array",
              "items": { "$ref": "#/$defs/OutputValidation" },
              "minItems": 1
            }
          ]
        },
        "validFrom": {
          "type": "string",
          "format": "date-time"
        },
        "validUntil": {
          "type": "string",
          "format": "date-time"
        }
      },
      "required": ["type", "action", "recognizedBy"]
    },
    "RecognizedActionOneOrMany": {
      "description": "One RecognizedAction or an array of RecognizedActions.",
      "oneOf": [
        { "$ref": "#/$defs/RecognizedAction" },
        {
          "type": "array",
          "items": { "$ref": "#/$defs/RecognizedAction" },
          "minItems": 1
        }
      ]
    },
    "RecognizedEntity": {
      "type": "object",
      "description": "An entity recognized to perform specific actions.",
      "allOf": [
        { "$ref": "#/$defs/GeneralProperties" }
      ],
      "properties": {
        "id": {
          "type": "string",
          "format": "uri"
        },
        "type": {
          "oneOf": [
            {
              "type": "string",
              "const": "RecognizedEntity"
            },
            {
              "type": "array",
              "contains": { "const": "RecognizedEntity" },
              "items": { "type": "string" }
            }
          ]
        },
        "recognizedTo": {
          "$ref": "#/$defs/RecognizedActionOneOrMany"
        }
      },
      "required": ["id", "type"]
    },
    "RecognizedIssuer": {
      "type": "object",
      "description": "An issuer that is recognized within a trust framework. The RE spec requires type RecognizedIssuer on the issuer of a RecognizedEntityCredential.",
      "allOf": [
        { "$ref": "#/$defs/GeneralProperties" }
      ],
      "properties": {
        "id": {
          "type": "string",
          "format": "uri"
        },
        "type": {
          "oneOf": [
            {
              "type": "string",
              "const": "RecognizedIssuer"
            },
            {
              "type": "array",
              "contains": { "const": "RecognizedIssuer" },
              "items": { "type": "string" }
            }
          ]
        },
        "recognizedIn": {
          "$ref": "#/$defs/RecognizedIn"
        }
      },
      "required": ["id", "type"]
    },
    "SubjectOneOrMany": {
      "description": "Helper: accepts a single subject or an array. Layer 2 schemas override credentialSubject to $ref this with the appropriate subject type.",
      "oneOf": [
        { "$ref": "#/$defs/RecognizedEntity" },
        {
          "type": "array",
          "items": { "$ref": "#/$defs/RecognizedEntity" },
          "minItems": 1
        }
      ]
    }
  },
  "properties": {
    "type": {
      "type": "array",
      "contains": { "const": "VerifiableCredential" },
      "allOf": [
        {
          "contains": { "const": "RecognizedEntityCredential" }
        }
      ]
    },
    "issuer": {
      "oneOf": [
        { "type": "string", "format": "uri" },
        { "$ref": "#/$defs/RecognizedIssuer" }
      ]
    },
    "credentialSubject": {
      "$ref": "#/$defs/SubjectOneOrMany"
    }
  },
  "required": ["@context", "type", "issuer", "credentialSubject"]
}
