{
  "$id": "gs1-data-credential",
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "title": "DataCredential",
  "description": "A GS1 Data Credential declaring facts about a GS1 ID Key. The issuer's recognizedIn links to a GS1KeyCredential that delegates authority to issue data about the specified key.",
  "type": "object",
  "allOf": [
    {
      "$ref": "https://www.w3.org/2022/credentials/v2/verifiable-credential-schema.json"
    }
  ],
  "$defs": {
    "DataCredentialSubject": {
      "title": "GS1 Data Credential Subject",
      "type": "object",
      "properties": {
        "id": {
          "$ref": "gs1-common.json#/$defs/GS1DigitalLink"
        }
      },
      "required": ["id"]
    }
  },
  "properties": {
    "@context": {
      "$ref": "recognized-entity-credential.json#/$defs/ContextArray",
      "allOf": [
        { "contains": { "const": "https://www.w3.org/ns/credentials/v2" } },
        { "contains": { "const": "https://www.w3.org/ns/credentials/recognized-entities/v1" } },
        { "contains": { "const": "https://ref.gs1.org/gs1/vc/declaration-context" } }
      ]
    },
    "type": {
      "type": "array",
      "contains": { "const": "DataCredential" }
    },
    "issuer": {
      "type": "object",
      "properties": {
        "id": {
          "$ref": "recognized-entity-credential.json#/$defs/DID"
        },
        "recognizedIn": {
          "allOf": [
            { "$ref": "recognized-entity-credential.json#/$defs/RecognizedIn" },
            {
              "properties": {
                "type": {
                  "type": "array",
                  "allOf": [
                    { "contains": { "const": "RecognizedEntityCredential" } },
                    { "contains": { "const": "GS1KeyCredential" } }
                  ]
                }
              }
            }
          ]
        }
      },
      "required": ["id"]
    },
    "credentialSubject": {
      "oneOf": [
        { "$ref": "#/$defs/DataCredentialSubject" },
        { "type": "array", "items": { "$ref": "#/$defs/DataCredentialSubject" }, "minItems": 1 }
      ]
    }
  },
  "required": ["@context", "type", "issuer", "credentialSubject"]
}
