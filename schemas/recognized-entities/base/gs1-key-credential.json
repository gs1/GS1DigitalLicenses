{
  "$id": "gs1-key-credential",
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "title": "KeyCredential",
  "description": "A GS1 ID Key Credential asserting the existence of a specific GS1 ID Key. Does not require Recognized Entity properties.",
  "type": "object",
  "allOf": [
    {
      "$ref": "https://www.w3.org/2022/credentials/v2/verifiable-credential-schema.json"
    }
  ],
  "$defs": {
    "KeyCredentialSubject": {
      "title": "GS1 Key Credential Subject",
      "type": "object",
      "properties": {
        "id": {
          "$ref": "gs1-common.json#/$defs/GS1DigitalLink"
        }
      },
      "required": ["id"]
    }
  },
  "properties": {
    "@context": {
      "$ref": "recognized-entity-credential.json#/$defs/ContextArray",
      "allOf": [
        { "contains": { "const": "https://www.w3.org/ns/credentials/v2" } },
        { "contains": { "const": "https://ref.gs1.org/gs1/vc/declaration-context" } }
      ]
    },
    "type": {
      "type": "array",
      "contains": { "const": "KeyCredential" }
    },
    "issuer": {
      "oneOf": [
        { "$ref": "recognized-entity-credential.json#/$defs/DID" },
        {
          "type": "object",
          "properties": {
            "id": { "$ref": "recognized-entity-credential.json#/$defs/DID" }
          },
          "required": ["id"]
        }
      ]
    },
    "credentialSubject": {
      "oneOf": [
        { "$ref": "#/$defs/KeyCredentialSubject" },
        { "type": "array", "items": { "$ref": "#/$defs/KeyCredentialSubject" }, "minItems": 1 }
      ]
    }
  },
  "required": ["@context", "type", "issuer", "credentialSubject"]
}
