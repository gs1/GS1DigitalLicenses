{
  "$id": "gs1-key-authorization-credential",
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "title": "KeyAuthorizationCredential",
  "description": "Authorizes an entity (DID) to issue data credentials about a specific GS1 ID Key (GS1 Digital Link). The outputValidation in recognizedAction constrains what the authorized party may include.",
  "type": "object",
  "allOf": [
    {
      "$ref": "recognized-entity-credential.json"
    }
  ],
  "$defs": {
    "KeyAuthorizationSubject": {
      "title": "Key Authorization Subject",
      "type": "object",
      "properties": {
        "id": {
          "$ref": "recognized-entity-credential.json#/$defs/DID"
        },
        "type": {
          "oneOf": [
            { "const": "RecognizedEntity" },
            { "type": "array", "contains": { "const": "RecognizedEntity" } }
          ]
        },
        "name": {
          "type": "string"
        },
        "url": {
          "type": "string",
          "format": "uri"
        },
        "gs1DigitalLink": {
          "title": "The GS1 Digital Link URI of the key this authorization covers.",
          "$ref": "gs1-common.json#/$defs/GS1DigitalLink"
        },
        "recognizedTo": {
          "$ref": "recognized-entity-credential.json#/$defs/RecognizedActionOneOrMany"
        },
        "recognizedIn": {
          "$ref": "recognized-entity-credential.json#/$defs/RecognizedIn"
        }
      },
      "required": ["id", "type", "gs1DigitalLink", "recognizedTo"]
    }
  },
  "properties": {
    "@context": {
      "$ref": "recognized-entity-credential.json#/$defs/ContextArray",
      "allOf": [
        { "contains": { "const": "https://www.w3.org/ns/credentials/v2" } },
        { "contains": { "const": "https://www.w3.org/ns/credentials/recognized-entities/v1" } },
        { "contains": { "const": "https://ref.gs1.org/gs1/vc/declaration-context" } }
      ]
    },
    "type": {
      "type": "array",
      "contains": { "const": "KeyAuthorizationCredential" }
    },
    "issuer": {
      "type": "object",
      "properties": {
        "id": {
          "$ref": "recognized-entity-credential.json#/$defs/DID"
        },
        "recognizedIn": {
          "allOf": [
            { "$ref": "recognized-entity-credential.json#/$defs/RecognizedIn" },
            {
              "properties": {
                "type": {
                  "type": "array",
                  "allOf": [
                    { "contains": { "const": "RecognizedEntityCredential" } },
                    {
                      "oneOf": [
                        { "contains": { "const": "GS1CompanyPrefixLicenseCredential" } },
                        { "contains": { "const": "GS1IdentificationKeyLicenseCredential" } }
                      ]
                    }
                  ]
                }
              }
            }
          ]
        }
      },
      "required": ["id", "recognizedIn"]
    },
    "credentialSubject": {
      "oneOf": [
        { "$ref": "#/$defs/KeyAuthorizationSubject" },
        { "type": "array", "items": { "$ref": "#/$defs/KeyAuthorizationSubject" }, "minItems": 1 }
      ]
    }
  },
  "required": ["@context", "type", "issuer", "credentialSubject"]
}
