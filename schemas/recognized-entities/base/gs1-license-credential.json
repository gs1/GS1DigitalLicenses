{
  "$id": "gs1-license-credential",
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "title": "GS1LicenseCredential",
  "description": "Base schema for all GS1 License Credentials. Captures shared VCDM requirements and common license properties (organization, licenseValue) per the GS1 Digital Licenses specification.",
  "type": "object",
  "allOf": [
    {
      "$ref": "recognized-entity-credential.json"
    }
  ],
  "$defs": {
    "LicenseSubjectBase": {
      "title": "GS1 License Subject Base",
      "description": "Common properties shared by all license credential subjects.",
      "type": "object",
      "properties": {
        "id": {
          "$ref": "recognized-entity-credential.json#/$defs/DID"
        },
        "type": {
          "oneOf": [
            { "const": "RecognizedEntity" },
            { "type": "array", "contains": { "const": "RecognizedEntity" } }
          ]
        },
        "organization": {
          "$ref": "gs1-common.json#/$defs/Organization"
        },
        "licenseValue": {
          "title": "GS1 License Value",
          "type": "string"
        },
        "alternativeLicenseValue": {
          "type": "string"
        },
        "identificationKeyType": {
          "$ref": "gs1-common.json#/$defs/GS1IdentificationKeyTypeCode"
        },
        "recognizedTo": {
          "$ref": "recognized-entity-credential.json#/$defs/RecognizedActionOneOrMany"
        },
        "recognizedIn": {
          "$ref": "recognized-entity-credential.json#/$defs/RecognizedIn"
        }
      },
      "required": ["id", "type", "organization", "licenseValue"]
    },
    "CredentialStatus": {
      "title": "BitstringStatusListEntry",
      "type": "object",
      "properties": {
        "id": { "type": "string", "format": "uri" },
        "type": { "const": "BitstringStatusListEntry" },
        "statusPurpose": { "type": "string" },
        "statusListIndex": { "type": "string" },
        "statusListCredential": { "type": "string", "format": "uri" }
      },
      "required": ["id", "type", "statusPurpose", "statusListIndex", "statusListCredential"]
    },
    "CredentialSchema": {
      "title": "JsonSchema Credential Schema",
      "type": "object",
      "properties": {
        "id": { "type": "string", "format": "uri" },
        "type": { "const": "JsonSchema" }
      },
      "required": ["id", "type"]
    },
    "RenderMethod": {
      "title": "TemplateRenderMethod",
      "type": "object",
      "properties": {
        "type": { "const": "TemplateRenderMethod" },
        "renderSuite": { "type": "string" },
        "name": { "type": "string" },
        "template": {
          "type": "object",
          "properties": {
            "id": { "type": "string", "format": "uri" },
            "mediaType": { "type": "string" },
            "digestMultibase": { "type": "string" }
          },
          "required": ["id", "mediaType", "digestMultibase"]
        }
      },
      "required": ["type", "renderSuite", "name", "template"]
    }
  },
  "properties": {
    "@context": {
      "$ref": "recognized-entity-credential.json#/$defs/ContextArray",
      "allOf": [
        { "contains": { "const": "https://www.w3.org/ns/credentials/v2" } },
        { "contains": { "const": "https://www.w3.org/ns/credentials/recognized-entities/v1" } },
        { "contains": { "const": "https://ref.gs1.org/gs1/vc/license-context" } }
      ]
    },
    "id": {
      "type": "string",
      "format": "uri"
    },
    "issuer": {
      "type": "object",
      "properties": {
        "id": {
          "$ref": "recognized-entity-credential.json#/$defs/DID"
        }
      },
      "required": ["id"]
    },
    "name": {
      "type": "string"
    },
    "description": {
      "type": "string"
    },
    "credentialStatus": {
      "$ref": "#/$defs/CredentialStatus"
    },
    "credentialSchema": {
      "$ref": "#/$defs/CredentialSchema"
    },
    "renderMethod": {
      "type": "array",
      "items": { "$ref": "#/$defs/RenderMethod" },
      "minItems": 1
    }
  },
  "required": ["@context", "type", "issuer", "id", "validFrom", "name", "description", "credentialSubject", "credentialStatus", "credentialSchema", "renderMethod"]
}
